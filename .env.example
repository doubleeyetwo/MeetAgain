# Firebase web app configuration. Copy to .env for local development.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public OAuth client IDs for each target platform. These are not client secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Places API (New) key. Lives in its own Cloud project, not the Firebase one.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Set to false for manual-address-only testing. Restart Expo after changing it.
EXPO_PUBLIC_ENABLE_PLACE_SUGGESTIONS=true

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      function validIdentity() {
        return request.auth != null
          && request.auth.uid == userId
          && request.resource.data.id == userId
          && request.resource.data.email == request.auth.token.email;
      }
      function validCompletedProfile() {
        return request.resource.data.keys().hasAll(['id', 'email', 'firstName', 'lastName', 'displayName', 'username', 'dateOfBirth', 'profileComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'email', 'firstName', 'lastName', 'displayName', 'username', 'dateOfBirth', 'profileComplete', 'bio', 'photoDataUrl', 'photoURL', 'createdAt', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$')
        && request.resource.data.profileComplete == true
        && (!request.resource.data.keys().hasAny(['bio']) || (
          request.resource.data.bio is string && request.resource.data.bio.size() <= 300
        ))
        && (!request.resource.data.keys().hasAny(['photoDataUrl']) || (
          request.resource.data.photoDataUrl is string
          && request.resource.data.photoDataUrl.size() <= 200023
          && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        ))
        && (!request.resource.data.keys().hasAny(['photoURL']) || (
          request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 2048
          && request.resource.data.photoURL.matches('^https://lh[0-9]+[.]googleusercontent[.]com/.*$')
          && request.auth.token.firebase.sign_in_provider == 'google.com'
        ))
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      }
      // Google signup first creates a minimal document; profile setup completes it once.
      allow create: if validIdentity()
        && ((request.resource.data.keys().hasAll(['id', 'email', 'profileComplete', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['id', 'email', 'profileComplete', 'createdAt', 'updatedAt'])
          && request.resource.data.profileComplete == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time)
          || (validCompletedProfile() && request.resource.data.createdAt == request.time));
      allow update: if validIdentity()
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.get('profileComplete', true) == false && validCompletedProfile())
          || (resource.data.get('profileComplete', true) == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['firstName', 'lastName', 'displayName', 'bio', 'photoDataUrl', 'updatedAt'])
            && request.resource.data.firstName is string
            && request.resource.data.firstName.size() > 0
            && request.resource.data.firstName.size() <= 80
            && request.resource.data.lastName is string
            && request.resource.data.lastName.size() > 0
            && request.resource.data.lastName.size() <= 80
            && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
            && request.resource.data.bio is string
            && request.resource.data.bio.size() <= 300
            && (!request.resource.data.keys().hasAny(['photoDataUrl']) || (
              request.resource.data.photoDataUrl is string
              && request.resource.data.photoDataUrl.size() <= 200023
              && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            ))
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.displayName == request.resource.data.displayName
            && getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data.displayName == request.resource.data.displayName
            && getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data.get('bio', '') == request.resource.data.bio
            && getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data.get('photoDataUrl', '') == request.resource.data.get('photoDataUrl', '')));
      allow delete: if request.auth != null && request.auth.uid == userId
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(userId))
        && !existsAfter(/databases/$(database)/documents/friendCounts/$(userId));
    }
    match /publicProfiles/{userId} {
      allow get: if request.auth != null;
      function matchesPrivateProfile() {
        let profile = getAfter(/databases/$(database)/documents/users/$(userId)).data;
        return request.resource.data.id == userId
          && request.resource.data.displayName == profile.displayName
          && request.resource.data.username == profile.username
          && request.resource.data.get('dateOfBirth', '') == profile.get('dateOfBirth', '')
          && request.resource.data.get('bio', '') == profile.get('bio', '')
          && request.resource.data.get('photoDataUrl', '') == profile.get('photoDataUrl', '')
          && request.resource.data.get('photoURL', '') == profile.get('photoURL', '')
          && request.resource.data.updatedAt == profile.updatedAt;
      }
      function validPublicProfile() {
        return request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['id', 'displayName', 'username', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['id', 'displayName', 'username', 'dateOfBirth', 'bio', 'photoURL', 'photoDataUrl', 'createdAt', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 161
          && request.resource.data.username is string
          && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
          && (!request.resource.data.keys().hasAny(['dateOfBirth']) || (
            request.resource.data.dateOfBirth is string
            && request.resource.data.dateOfBirth.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$')
          ))
          && (!request.resource.data.keys().hasAny(['bio']) || (
            request.resource.data.bio is string && request.resource.data.bio.size() <= 300
          ))
          && (!request.resource.data.keys().hasAny(['photoURL']) || (
            request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
          ))
          && (!request.resource.data.keys().hasAny(['photoDataUrl']) || (
            request.resource.data.photoDataUrl is string
            && request.resource.data.photoDataUrl.size() <= 200023
            && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          ))
          && matchesPrivateProfile();
      }
      allow create: if validPublicProfile()
        && request.resource.data.createdAt == getAfter(/databases/$(database)/documents/users/$(userId)).data.createdAt;
      allow update: if validPublicProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio', 'photoDataUrl', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId
        && !existsAfter(/databases/$(database)/documents/users/$(userId));
    }
    match /usernames/{username} {
      // Signed-in users can look up an exact username.
      // Listing all usernames remains blocked.
      allow get: if request.auth != null;

      // A username belongs to the signed-in account.
      // If a display name is included, it must match that account's profile.
      allow create: if request.auth != null
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && (!request.resource.data.keys().hasAny(['displayName']) || (
          request.resource.data.displayName is string
          && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        ));

      // The owner can add or update the display name alongside their profile.
      allow update: if request.auth != null
        && resource.data.keys().hasAll(['uid'])
        && resource.data.keys().hasOnly(['uid', 'displayName'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'displayName'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Only totals are readable; friendship records remain participant-only.
    match /friendCounts/{userId} {
      allow get: if request.auth != null;
      // Existing accounts require a trusted backfill, never a client baseline.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!exists(/databases/$(database)/documents/users/$(userId))
          || get(/databases/$(database)/documents/users/$(userId)).data.profileComplete == false)
        && existsAfter(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 0;

      function validCountChange() {
        let pairId = request.resource.data.lastPairId;
        let pairPath = /databases/$(database)/documents/friendships/$(pairId);
        let before = get(pairPath).data;
        return request.resource.data.keys().hasAll(['count', 'lastPairId'])
          && request.resource.data.keys().hasOnly(['count', 'lastPairId'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && userId in before.memberIds
          && request.auth.uid in before.memberIds
          && (
            (before.status == 'pending'
              && request.auth.uid == before.recipientId
              && getAfter(pairPath).data.status == 'accepted'
              && request.resource.data.count == resource.data.count + 1)
            || (before.status == 'accepted' && !existsAfter(pairPath)
              && request.resource.data.count == resource.data.count - 1)
          );
      }
      allow update: if request.auth != null && validCountChange();
      allow delete: if request.auth != null && request.auth.uid == userId
        && !existsAfter(/databases/$(database)/documents/users/$(userId));
    }
    match /friendships/{friendshipId} {
      function countChanged(uid, delta) {
        let path = /databases/$(database)/documents/friendCounts/$(uid);
        return getAfter(path).data.count == get(path).data.count + delta
          && getAfter(path).data.lastPairId == friendshipId;
      }
      function bothCountsChanged(delta) {
        return countChanged(resource.data.memberIds[0], delta)
          && countChanged(resource.data.memberIds[1], delta);
      }
      // Every pair has two distinct UIDs in sorted order.
      // The document ID uses that same order to prevent duplicates.
      function validPair(data) {
        return data.memberIds is list
          && data.memberIds.size() == 2
          && data.requesterId is string
          && data.recipientId is string
          && data.requesterId.matches('^[A-Za-z0-9]{1,128}$')
          && data.recipientId.matches('^[A-Za-z0-9]{1,128}$')
          && data.requesterId != data.recipientId
          && data.memberIds == (
            data.requesterId < data.recipientId
              ? [data.requesterId, data.recipientId]
              : [data.recipientId, data.requesterId]
          )
          && friendshipId == data.memberIds[0] + '_' + data.memberIds[1];
      }

      // Each username must belong to the stated account.
      function validUsernames(data) {
        return data.requesterUsername is string
          && data.recipientUsername is string
          && data.requesterUsername.matches('^[a-z0-9_]{3,20}$')
          && data.recipientUsername.matches('^[a-z0-9_]{3,20}$')
          && get(/databases/$(database)/documents/users/$(data.requesterId)).data.username == data.requesterUsername
          && get(/databases/$(database)/documents/usernames/$(data.requesterUsername)).data.uid == data.requesterId
          && get(/databases/$(database)/documents/usernames/$(data.recipientUsername)).data.uid == data.recipientId;
      }

      // Participants can check their pair document even before it exists.
      // That check is needed when sending the first request.
      allow get: if request.auth != null
        && request.auth.uid.matches('^[A-Za-z0-9]{1,128}$')
        && (
          friendshipId.matches('^' + request.auth.uid + '_[A-Za-z0-9]{1,128}$')
          || friendshipId.matches('^[A-Za-z0-9]{1,128}_' + request.auth.uid + '$')
        );

      // Queries can return only relationships involving the signed-in user.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // A sender can create a pending request, never an accepted friendship.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'memberIds', 'requesterId', 'recipientId',
          'requesterUsername', 'recipientUsername',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'memberIds', 'requesterId', 'recipientId',
          'requesterUsername', 'recipientUsername',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && validPair(request.resource.data)
        && validUsernames(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Either participant may remove a pair. Accepted pairs must adjust both totals.
      allow delete: if request.auth != null
        && validPair(resource.data)
        && request.auth.uid in resource.data.memberIds
        && (resource.data.status in ['pending', 'declined']
          || (resource.data.status == 'accepted' && bothCountsChanged(-1)));

      // Participants and usernames cannot be changed after creation.
      // Only the recipient can accept or decline a pending request.
      // The original sender can resend a declined request.
      allow update: if request.auth != null
        && validUsernames(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'pending'
            && request.auth.uid == resource.data.recipientId
            && request.resource.data.status in ['accepted', 'declined']
            && (request.resource.data.status == 'declined' || bothCountsChanged(1))
          )
          || (
            resource.data.status == 'declined'
            && request.auth.uid == resource.data.requesterId
            && request.resource.data.status == 'pending'
          )
        );
    }
    // A canonical member-set claim gives every exact set one stable random group ID.
    // The creator is the first administrator; membership changes are not supported.
    match /groups/{groupId} {
      function validMemberIds(data) {
        let members = data.memberIds;
        return members is list
          && members.size() >= 2 && members.size() <= 10
          && members.join('_').matches('^[A-Za-z0-9]{1,128}(_[A-Za-z0-9]{1,128}){1,9}$')
          && (members.size() <= 1 || members[0] < members[1])
          && (members.size() <= 2 || members[1] < members[2])
          && (members.size() <= 3 || members[2] < members[3])
          && (members.size() <= 4 || members[3] < members[4])
          && (members.size() <= 5 || members[4] < members[5])
          && (members.size() <= 6 || members[5] < members[6])
          && (members.size() <= 7 || members[6] < members[7])
          && (members.size() <= 8 || members[7] < members[8])
          && (members.size() <= 9 || members[8] < members[9]);
      }
      function acceptedFriend(creatorId, memberId) {
        let pairId = creatorId < memberId
          ? creatorId + '_' + memberId : memberId + '_' + creatorId;
        return get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
      }
      function allSelectedFriends(data) {
        let members = data.memberIds;
        let creatorId = data.createdBy;
        return (members[0] == creatorId || acceptedFriend(creatorId, members[0]))
          && (members.size() <= 1 || members[1] == creatorId || acceptedFriend(creatorId, members[1]))
          && (members.size() <= 2 || members[2] == creatorId || acceptedFriend(creatorId, members[2]))
          && (members.size() <= 3 || members[3] == creatorId || acceptedFriend(creatorId, members[3]))
          && (members.size() <= 4 || members[4] == creatorId || acceptedFriend(creatorId, members[4]))
          && (members.size() <= 5 || members[5] == creatorId || acceptedFriend(creatorId, members[5]))
          && (members.size() <= 6 || members[6] == creatorId || acceptedFriend(creatorId, members[6]))
          && (members.size() <= 7 || members[7] == creatorId || acceptedFriend(creatorId, members[7]))
          && (members.size() <= 8 || members[8] == creatorId || acceptedFriend(creatorId, members[8]))
          && (members.size() <= 9 || members[9] == creatorId || acceptedFriend(creatorId, members[9]));
      }
      allow get, list: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && groupId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasAll(['name', 'memberIds', 'createdBy', 'adminIds', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdBy', 'adminIds', 'createdAt', 'updatedAt'])
        && validMemberIds(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && allSelectedFriends(request.resource.data)
        && getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.memberIds.join('_'))).data.groupId == groupId
        && getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.memberIds.join('_'))).data.memberIds == request.resource.data.memberIds
        && getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.memberIds.join('_'))).data.createdBy == request.auth.uid
        && request.resource.data.name == 'Group' + string(getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.memberIds.join('_'))).data.sequence);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.adminIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time;
        match /messages/{messageId} {
          function isGroupMember() {
            return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          }

          function validMessage() {
            let message = request.resource.data;

            return message.keys().hasAll(['senderId', 'text', 'createdAt'])
            && message.keys().hasOnly(['senderId', 'text', 'imageDataUrl', 'createdAt'])
            && message.senderId == request.auth.uid
            && message.text is string
            && message.text.size() <= 2000
            && (
              (message.text.size() > 0 && message.text.matches('[\\s\\S]*\\S[\\s\\S]*'))
              || message.keys().hasAny(['imageDataUrl'])
            )
            && (!message.keys().hasAny(['imageDataUrl']) || (
              message.imageDataUrl is string
              && message.imageDataUrl.size() <= 200023
              && message.imageDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            ))
            && message.createdAt == request.time;
          }

          allow read: if isGroupMember();
          allow create: if isGroupMember() && validMessage();
          allow update, delete: if false; //We can add editing and deleting messages as a stretch goal here
        }
    }
    match /groupMemberships/{memberKey} {
      // Missing claims can be checked by prospective members during creation.
      allow get: if request.auth != null && request.auth.uid in memberKey.split('_');
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['groupId', 'memberIds', 'createdBy', 'sequence'])
        && request.resource.data.keys().hasOnly(['groupId', 'memberIds', 'createdBy', 'sequence'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.join('_') == memberKey
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds == request.resource.data.memberIds
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.name == 'Group' + string(request.resource.data.sequence)
        && getAfter(/databases/$(database)/documents/groupCounters/$(request.auth.uid)).data.latestNumber == request.resource.data.sequence
        && getAfter(/databases/$(database)/documents/groupCounters/$(request.auth.uid)).data.lastMemberKey == memberKey;
    }

    match /groupCounters/{creatorId} {
      function validCounter() {
        return request.auth != null
          && request.auth.uid == creatorId
          && request.resource.data.keys().hasAll(['latestNumber', 'lastMemberKey'])
          && request.resource.data.keys().hasOnly(['latestNumber', 'lastMemberKey'])
          && request.resource.data.latestNumber is int
          && request.resource.data.latestNumber > 0
          && request.resource.data.lastMemberKey is string
          && getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.lastMemberKey)).data.createdBy == creatorId
          && getAfter(/databases/$(database)/documents/groupMemberships/$(request.resource.data.lastMemberKey)).data.sequence == request.resource.data.latestNumber;
      }
      allow get: if request.auth != null && request.auth.uid == creatorId;
      allow create: if validCounter() && request.resource.data.latestNumber == 1;
      allow update: if validCounter()
        && request.resource.data.latestNumber == resource.data.latestNumber + 1;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

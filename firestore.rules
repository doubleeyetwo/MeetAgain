rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      // Signup creates a completed profile alongside the matching username claim.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['id', 'email', 'firstName', 'lastName', 'displayName', 'username', 'dateOfBirth', 'profileComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'email', 'firstName', 'lastName', 'displayName', 'username', 'dateOfBirth', 'profileComplete', 'photoDataUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$')
        && request.resource.data.profileComplete == true
        && (!request.resource.data.keys().hasAny(['photoDataUrl']) || (
          request.resource.data.photoDataUrl is string
          && request.resource.data.photoDataUrl.size() <= 200023
          && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        ))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      // Edit Profile may change only these fields; identity, username, and email stay fixed
      // because the usernames/{username} claim and the auth token are the source of truth.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'displayName', 'bio', 'photoDataUrl', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && (!request.resource.data.keys().hasAny(['bio']) || (
          request.resource.data.bio is string
          && request.resource.data.bio.size() <= 300
        ))
        && (!request.resource.data.keys().hasAny(['photoDataUrl']) || (
          request.resource.data.photoDataUrl is string
          && request.resource.data.photoDataUrl.size() <= 200023
          && request.resource.data.photoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        ))
        && request.resource.data.updatedAt == request.time;
    }
    match /usernames/{username} {
      // Signed-in users can check availability; listing and changes are denied.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

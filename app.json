{
  "expo": {
    "name": "MeetAgain",
    "slug": "meetagain",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "meetagain",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fivestack.meetagain",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "043f5cd5-3ba4-4263-8e76-dcc46719fd51"
      }
    },
    "owner": "doubleeye2s-team"
  }
}

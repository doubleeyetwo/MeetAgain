{
  "expo": {
    "name": "MeetAgain",
    "slug": "meetagain",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "meetagain",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetagain.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.meetagain.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
